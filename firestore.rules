rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
        data.userId == request.auth.uid &&
        data.unlockedLevels is map &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('provider' in data) || (data.provider is string && data.provider.size() <= 50)) &&
        (!('currentLanguage' in data) || (data.currentLanguage is string && data.currentLanguage.size() <= 30)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if false;
    }

    match /competitions/{roomCode} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(roomCode) && incoming().creatorId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(roomCode) && (
        existing().creatorId == request.auth.uid ||
        incoming().participantId == request.auth.uid ||
        existing().participantId == request.auth.uid
      );
      allow delete: if isSignedIn() && existing().creatorId == request.auth.uid;
    }
  }
}
